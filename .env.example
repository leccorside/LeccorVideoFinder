# ==========================================
# VIDEOFINDER — VARIÁVEIS DE AMBIENTE (RAIZ)
# ==========================================

COMPOSE_PROJECT_NAME=videofinder
NGINX_PORT=8080
FRONTEND_PORT=3000
BACKEND_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379
SEARXNG_PORT=8081

# Banco de Dados MySQL
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=videofinder
MYSQL_USER=videouser
MYSQL_PASSWORD=videopass

# Ollama Local (Utiliza a instalação existente no seu computador)
# A porta padrão configurada no seu host é 11435
OLLAMA_PORT=11435
OLLAMA_LLM_MODEL=qwen2.5vl:7b
OLLAMA_EMBEDDING_MODEL=gpt-oss:20b

# Provedores de Vídeo (Opcional - Gratuito)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_LIMIT=9000

