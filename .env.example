# ==========================================
# VIDEOFINDER — PORTAS ISOLADAS (SEM CONFLITOS)
# ==========================================

COMPOSE_PROJECT_NAME=videofinder

# Portas públicas no Host (Faixa 18000 para isolamento total)
NGINX_PORT=18080
FRONTEND_PORT=18300
BACKEND_PORT=18000
MYSQL_PORT=18306
REDIS_PORT=18379
SEARXNG_PORT=18081

# Banco de Dados MySQL
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=videofinder
MYSQL_USER=videouser
MYSQL_PASSWORD=videopass

# Ollama Local (Utiliza a instalação nativa do seu host Windows na porta 11435)
OLLAMA_PORT=11435
OLLAMA_LLM_MODEL=qwen2.5vl:7b
OLLAMA_EMBEDDING_MODEL=gpt-oss:20b

# Provedores de Vídeo (Opcional - Gratuito)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_LIMIT=9000
