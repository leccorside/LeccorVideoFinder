APP_NAME=VideoFinder
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=videofinder
DB_USERNAME=videouser
DB_PASSWORD=videopass

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=videofinder_cache_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Conectores & Provedores
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_LIMIT=9000

SEARXNG_URL=http://searxng:8080

# Ollama Local (Utiliza o Ollama existente na máquina do usuário via host gateway)
OLLAMA_BASE_URL=http://host.docker.internal:11435
OLLAMA_LLM_MODEL=qwen2.5vl:7b
OLLAMA_EMBEDDING_MODEL=gpt-oss:20b
AI_SEMANTIC_SEARCH_ENABLED=true
AI_TIMEOUT_SECONDS=5

